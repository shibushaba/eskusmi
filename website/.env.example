# Optional: send visitors to a portfolio landing instead of this site.
# VITE_PORTFOLIO_ESKUSMI_URL=https://YOUR-PORTFOLIO-DOMAIN/eskusmi

# Optional per-OS overrides (defaults point at GitHub Releases latest/).
# Leave unset so the site auto-picks Windows / macOS / Linux from the visitor's device.
# VITE_DOWNLOAD_URL_WINDOWS=https://github.com/shibushaba/eskusmi/releases/latest/download/eskusmi-setup.exe
# VITE_DOWNLOAD_URL_MACOS=https://github.com/shibushaba/eskusmi/releases/latest/download/eskusmi.dmg
# VITE_DOWNLOAD_URL_LINUX=https://github.com/shibushaba/eskusmi/releases/latest/download/eskusmi.AppImage

# Fallback only when the OS cannot be detected:
# VITE_DOWNLOAD_URL=https://github.com/shibushaba/eskusmi/releases/latest/download/eskusmi-setup.exe
